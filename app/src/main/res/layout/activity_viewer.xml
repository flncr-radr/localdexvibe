<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/viewerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <SurfaceView
        android:id="@+id/surfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <TextView
        android:id="@+id/viewerStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:text="Starting…" />

    <!-- Toggled by the panel's Stats button; opposite corner from the exit tab so
         neither ever overlaps the other. -->
    <TextView
        android:id="@+id/viewerStatsOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:background="@drawable/stats_overlay_bg"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:fontFamily="monospace"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:visibility="gone" />

    <!--
        Side control tab: a handle peeks from the right edge; tap it to reveal the
        window controls and Stop, tap again to hide them. Driven directly by
        translationX (see ViewerActivity.setupControlPanel) rather than
        BottomSheetBehavior — that wasn't reliably collapsing on first layout.

        The background lives on the handle and the button column separately, not on
        the panel as a whole: with it on the panel, the collapsed state painted a
        strip as tall as the whole button column, which is a lot of screen for
        something that's only a grip. This way the collapsed tab is just the
        handle's own 24x64dp rounded tab.

        The handle is still a real touch target rather than the thin grip line
        inside it, and ViewerActivity carves its bounds out of the system's
        edge-swipe gesture (setSystemGestureExclusionRects) — at this edge that
        gesture otherwise competes for the same taps and wins.
    -->
    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:id="@+id/controlPanelHandle"
            android:layout_width="24dp"
            android:layout_height="64dp"
            android:background="@drawable/control_panel_bg">

            <View
                android:id="@+id/controlPanelGrip"
                android:layout_width="4dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:background="@drawable/panel_grip" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/control_panel_bg"
            android:paddingHorizontal="16dp"
            android:paddingVertical="16dp">

            <!-- Side by side so their positions match what they do. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/viewerSnapLeftButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/outline"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textColor="@color/on_surface"
                    android:text="◀ Left" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/viewerSnapRightButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/outline"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textColor="@color/on_surface"
                    android:text="Right ▶" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/viewerRestoreButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:paddingHorizontal="20dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="12dp"
                app:strokeColor="@color/outline"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textColor="@color/on_surface"
                android:text="Window / Full" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/viewerStatsButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="20dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="12dp"
                app:strokeColor="@color/outline"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textColor="@color/on_surface"
                android:text="Show Stats" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/viewerStopButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="20dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="12dp"
                app:strokeColor="@color/error"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textColor="@color/error"
                android:text="Stop DeX" />
        </LinearLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
